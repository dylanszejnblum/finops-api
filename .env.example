PORT=3000
LOG_LEVEL=info

# Admin keys (comma-separated) for the x-api-key header. Create scoped keys via POST /v1/admin/api-keys (needs a DB).
API_KEYS=change-me

# Mercury: a READ-ONLY token incl. the "secret-token:" prefix. Restrict it to your server's egress IPs in the Mercury dashboard.
MERCURY_API_TOKEN=
# Sandbox: https://api-sandbox.mercury.com/api/v1
MERCURY_BASE_URL=https://api.mercury.com/api/v1
# Seconds to cache balances per instance (0 = off)
BALANCE_CACHE_SECONDS=30

# Optional. Empty = no DB (ledger, reports and key admin are disabled).
# postgres://user:pass@host:5432/db | mysql://... | mariadb://...
DATABASE_URL=
# true = verified TLS, no-verify = TLS without cert check, empty = off
DATABASE_SSL=

# Ledger sync (only with a DB)
SYNC_INTERVAL_MINUTES=30
SYNC_LOOKBACK_DAYS=30
SYNC_BACKFILL_DAYS=365
